# ── MaaS Gateway ──
MAAS_GATEWAY=https://your-maas-gateway-url
MAAS_MODEL_PRIMARY=gemma4
MAAS_MODEL_SECONDARY=qwen35-9b
# MLflow cost tracking needs model names from its pricing table.
# These are used in the OpenAI SDK "model" field for cost attribution.
# The actual model routing is done by the URL path, not this field.
# Must be model names from LiteLLM pricing table.
# See: https://github.com/BerriAI/litellm/blob/main/model_prices_and_context_window.json
# Common valid names: claude-sonnet-4-5, gpt-4o-mini, gpt-4o, gemini-2.0-flash
MLFLOW_MODEL_ALIAS_PRIMARY=claude-sonnet-4-5
MLFLOW_MODEL_ALIAS_SECONDARY=gpt-4o-mini

# ── API keys per department ──
# Get from RHOAI Dashboard > Gen AI Studio > API keys
# Each key shows as a separate user in the Perses Usage dashboard
API_KEY_ENGINEERING=your-engineering-api-key
API_KEY_MARKETING=your-marketing-api-key
API_KEY_SUPPORT=your-support-api-key

# ── MLflow (local mode, for generate-load.py on laptop) ──
# Leave blank to log traces locally in ./mlruns
# Set to your external MLflow URL for remote logging from laptop
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=

# ── MLflow (in-cluster mode, for deploy-on-cluster.sh) ──
# Internal MLflow service URL (ask your MLflow admin)
MLFLOW_INTERNAL_URI=https://mlflow.redhat-ods-applications.svc.cluster.local:8443
# Your OpenShift namespace (used as MLflow workspace)
MLFLOW_WORKSPACE=your-namespace

# ── Load generation settings ──
DURATION_MINUTES=5
ENGINEERING_INTERVAL=5
MARKETING_INTERVAL=12
SUPPORT_INTERVAL=20
MAX_TOKENS_ENGINEERING=512
MAX_TOKENS_MARKETING=384
MAX_TOKENS_SUPPORT=256
